{
  "experiment_version": "1.0.0",
  "status": "predeclared_before_temporal_model_training",
  "random_seed": 42,
  "sealed_holdout_policy": {
    "split": "holdout",
    "allowed_for_feature_selection": false,
    "allowed_for_model_selection": false,
    "allowed_for_threshold_selection": false,
    "allowed_for_reporting_challenger_metrics": false,
    "note": "The existing final holdout remains sealed. All challenger comparisons use development for fitting and calibration for evaluation."
  },
  "primary_metric": "average_precision",
  "secondary_metrics": [
    "roc_auc",
    "brier_score",
    "log_loss",
    "top_10_percent.event_capture_rate",
    "top_20_percent.event_capture_rate"
  ],
  "fixed_temporal_design": {
    "installment_half_lives_days": [90, 180, 365],
    "monthly_half_lives_months": [3, 6, 12],
    "rolling_windows_days": [30, 90, 180, 365, 730],
    "recent_sequence_positions": 6,
    "credit_cycling_minimum_independent_families": 2
  },
  "feature_experiments": [
    "frozen_v1_baseline",
    "v1_plus_repayment_recency",
    "v1_plus_repayment_sequence",
    "v1_plus_installment_temporal",
    "v1_plus_previous_velocity",
    "v1_plus_pos_bureau_burden",
    "v1_plus_credit_cycling",
    "v1_plus_credit_card_temporal",
    "v1_plus_all_temporal",
    "v1_plus_all_structural_pruning",
    "v1_plus_all_without_external_scores"
  ],
  "model_experiments": [
    "lightgbm_standard",
    "lightgbm_high_capacity",
    "catboost_native_if_available",
    "fixed_equal_weight_lightgbm_ensemble"
  ],
  "structural_pruning": {
    "basis": "algebraic or source-key equivalence declared before outcomes are inspected",
    "drop": [
      "PREV_APPLICATION_COUNT",
      "BUREAU_CREDIT_COUNT",
      "CREDIT_TO_GOODS"
    ]
  },
  "bootstrap": {
    "iterations": 300,
    "method": "paired stratified applicant bootstrap on calibration rows",
    "confidence_level": 0.95
  },
  "research_promotion_gates": {
    "minimum_absolute_average_precision_gain": 0.003,
    "minimum_probability_ap_gain_positive": 0.9,
    "maximum_brier_regression": 0.0002,
    "maximum_roc_auc_regression": 0.001,
    "maximum_top_20_capture_regression": 0.005,
    "required_data_quality_gate": true,
    "note": "Passing these gates promotes a challenger only to further validation, never to production or the sealed holdout."
  }
}
